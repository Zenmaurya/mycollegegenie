{
  "entities": {
    "ForumPost": {
      "title": "ForumPost",
      "description": "A post in the discussion forum.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the post." },
        "content": { "type": "string", "description": "The content of the post." },
        "authorId": { "type": "string", "description": "The UID of the author." },
        "authorName": { "type": "string", "description": "The name of the author." },
        "course": { "type": "string", "description": "The course associated with the post." },
        "topic": { "type": "string", "description": "The topic or category of the post." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The time the post was created." },
        "commentCount": { "type": "integer", "description": "The number of comments on the post." },
        "upvotes": { "type": "array", "items": { "type": "string" }, "description": "List of user IDs who upvoted." }
      },
      "required": ["title", "content", "authorId", "authorName", "course", "topic", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a forum post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "The ID of the parent post." },
        "authorId": { "type": "string", "description": "The UID of the author." },
        "authorName": { "type": "string", "description": "The name of the author." },
        "content": { "type": "string", "description": "The content of the comment." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The time the comment was created." }
      },
      "required": ["postId", "authorId", "authorName", "content", "createdAt"]
    },
    "Resource": {
      "title": "Resource",
      "description": "A study resource like notes, PYQs, or playlists.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the resource." },
        "type": { "type": "string", "enum": ["Note", "PYQ", "Playlist", "Book"], "description": "The type of resource." },
        "subCategory": { "type": "string", "description": "The sub-category (e.g., Lecture Notes, PYQs)." },
        "course": { "type": "string", "description": "The course name." },
        "semester": { "type": "integer", "description": "The semester number." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "List of tags." },
        "description": { "type": "string", "description": "A brief description." },
        "link": { "type": "string", "description": "The primary link (website or youtube)." },
        "directDownloadLink": { "type": "string", "description": "Optional direct download link for PDFs." },
        "uploader": { "type": "string", "description": "Name of the uploader." },
        "uploaderId": { "type": "string", "description": "UID of the uploader." },
        "uploadDate": { "type": "string", "format": "date", "description": "The date it was uploaded." },
        "ratings": { "type": "array", "items": { "type": "integer" }, "description": "List of ratings." },
        "reports": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "reason": { "type": "string" },
              "date": { "type": "string", "format": "date-time" }
            }
          }, 
          "description": "List of reports." 
        },
        "isApproved": { "type": "boolean", "description": "Whether the resource is approved by admin." }
      },
      "required": ["title", "type", "subCategory", "course", "semester", "link", "uploader", "uploadDate"]
    },
    "User": {
      "title": "User",
      "description": "User profile and role information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID." },
        "email": { "type": "string", "format": "email", "description": "The user's email." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "description": "The user's photo URL." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "The user's role." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user account was created." }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "PGListing": {
      "title": "PGListing",
      "description": "A listing for finding a PG partner.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "The UID of the author." },
        "authorName": { "type": "string", "description": "The name of the author." },
        "authorPhoto": { "type": "string", "description": "Optional photo URL of the author." },
        "college": { "type": "string", "description": "The college of the author." },
        "location": { "type": "string", "description": "The location of the PG." },
        "budget": { "type": "string", "description": "The budget range." },
        "gender": { "type": "string", "enum": ["Male", "Female", "Any"], "description": "Gender preference." },
        "description": { "type": "string", "description": "Description of the listing." },
        "socialLink": { "type": "string", "description": "Social media link or contact method." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the listing was created." }
      },
      "required": ["authorId", "authorName", "college", "location", "budget", "gender", "description", "socialLink", "createdAt"]
    },
    "News": {
      "title": "News",
      "description": "A news or event update.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the news/event." },
        "date": { "type": "string", "description": "The date of the news/event." },
        "summary": { "type": "string", "description": "A brief summary." },
        "url": { "type": "string", "description": "Source URL." },
        "category": { "type": "string", "enum": ["News", "Event"], "description": "Category." },
        "college": { "type": "string", "description": "College name or 'Delhi University'." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was posted." }
      },
      "required": ["title", "date", "summary", "category", "college", "createdAt"]
    }
  },
  "firestore": {
    "/forum_posts/{postId}": {
      "schema": "ForumPost",
      "description": "Collection of forum posts."
    },
    "/forum_posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Sub-collection of comments for a specific post."
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Collection of study resources."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "/pg_listings/{listingId}": {
      "schema": "PGListing",
      "description": "Collection of PG partner listings."
    }
  }
}
