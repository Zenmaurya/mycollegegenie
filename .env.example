# ============================================================
# MyCollegeGenie — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# ⚠️  NEVER commit .env to GitHub — it contains real secrets!
# ============================================================

# ─── Supabase ───────────────────────────────────────────────
# Get from: https://supabase.com → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Backend API ─────────────────────────────────────────────
# URL of your backend server (localhost for dev, production URL for prod)
VITE_API_URL=http://localhost:4000

# ─── Sentry (Error Tracking) ─────────────────────────────────
# Get from: https://sentry.io → New Project → React → DSN
# Leave empty to disable error tracking
VITE_SENTRY_DSN=

# ─── PostHog (Analytics) ─────────────────────────────────────
# Get from: https://posthog.com → Project Settings → Project API Key
# Leave empty to disable analytics
VITE_POSTHOG_KEY=your_posthog_key_here
